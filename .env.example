# ==============================================================================
# FairProctor AI — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your local or production environment.
# Never commit your real .env file with production secrets to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If MongoDB is running locally, use: mongodb://127.0.0.1:27017/fairproctor_auth
# If using MongoDB Atlas, use: mongodb+srv://<username>:<password>@cluster.mongodb.net/fairproctor_auth?retryWrites=true&w=majority
# NOTE: If MongoDB is unavailable or not running, the application gracefully
# operates using a persistent local JSON store in server/data/users.json.
MONGODB_URI=mongodb://127.0.0.1:27017/fairproctor_auth

# JWT Secrets (Generate strong random 64-char hex strings in production)
# Example command to generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_key_change_in_production_min32chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production_min32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
JWT_REMEMBER_ME_EXPIRES_IN=30d

# Cookie Security
COOKIE_SECRET=your_cookie_secret_change_in_production_32chars
# Set to 'true' in production with HTTPS, 'false' in local development over HTTP
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Password Reset Token Expiration (in milliseconds, 15 minutes = 900000)
PASSWORD_RESET_TOKEN_EXPIRY_MS=900000

# Email Delivery (SMTP / Nodemailer)
# If SMTP credentials are left blank or unconfigured, the system runs in DEVELOPMENT
# EMAIL MODE: password reset links are securely displayed in the server console,
# recorded to server/data/mail_audit.log, and provided in development API responses.
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="FairProctor AI Security" <security@fairproctor.ai>

# Security Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
